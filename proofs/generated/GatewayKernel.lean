def eligible
  (d : Deployment) (usage : alloc.vec.Vec Usage) (model : Std.U64)
  (now : Std.U64) (exclude : alloc.vec.Vec Std.U64) :
  Result Bool
  := do
  if d.model != model
  then ok false
  else
    if d.enabled
    then
      if now < d.cooldown_until
      then ok false
      else
        let b ← contains exclude d.id
        if b
        then ok false
        else
          let i ← window_of now
          let (r, t) ← used usage SCOPE_DEPLOYMENT d.id i
          under_limits r t d.rpm d.tpm
    else ok false

