@[rust_loop_body]
def route_loop.body
  (deps : alloc.vec.Vec Deployment) (usage : alloc.vec.Vec Usage)
  (model : Std.U64) (now : Std.U64) (exclude : alloc.vec.Vec Std.U64)
  (w : Std.U64) (best : Option Deployment) (best_load : Std.U64)
  (i : Std.Usize) :
  Result (ControlFlow ((Option Deployment) × Std.U64 × Std.Usize) (Option
    Deployment))
  := do
  let i1 := alloc.vec.Vec.len deps
  if i < i1
  then
    let d ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Deployment)
        deps i
    let b ← eligible d usage model now exclude
    let (best1, best_load1) ←
      if b
      then
        do
        let (load, _) ← used usage SCOPE_DEPLOYMENT d.id w
        let (i2, i3, i4, i5, i6, i7, i8, b1, i9, i10, i11, i12) ←
          match best with
          | none =>
            ok (d.id, d.model, d.input_cost, d.output_cost, d.rpm, d.tpm,
              d.priority, d.enabled, d.fails, d.fail_window, d.cooldown_until,
              load)
          | some b2 =>
            do
            let b3 ← before d.priority load d.id b2.priority best_load b2.id
            if b3
            then
              ok (d.id, d.model, d.input_cost, d.output_cost, d.rpm, 
                d.tpm, d.priority, d.enabled, d.fails, d.fail_window,
                d.cooldown_until, load)
            else
              ok (b2.id, b2.model, b2.input_cost, b2.output_cost, b2.rpm,
                b2.tpm, b2.priority, b2.enabled, b2.fails, b2.fail_window,
                b2.cooldown_until, best_load)
        ok (some
          ({
             id := i2,
             model := i3,
             input_cost := i4,
             output_cost := i5,
             rpm := i6,
             tpm := i7,
             priority := i8,
             enabled := b1,
             fails := i9,
             fail_window := i10,
             cooldown_until := i11
           } : Deployment), i12)
      else ok (best, best_load)
    let i2 ← i + 1#usize
    ok (cont (best1, best_load1, i2))
  else ok (done best)

