def before
  (p1 : Std.U64) (l1 : Std.U64) (id1 : Std.U64) (p2 : Std.U64) (l2 : Std.U64)
  (id2 : Std.U64) :
  Result Bool
  := do
  if p1 < p2
  then ok true
  else
    if p1 = p2
    then
      if l1 < l2
      then ok true
      else if l1 = l2
           then ok (id1 < id2)
           else ok false
    else ok false

