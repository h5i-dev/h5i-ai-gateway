def settle
  (a : Principal) (s : Snapshot) (id : Std.U64) (prompt_tokens : Std.U64)
  (completion_tokens : Std.U64) (status : CallStatus) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_reservation s.reservations id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some r =>
    let b ← may_close a s r
    if b
    then
      let w ← window_of a.now
      let c ← cost r.input_cost r.output_cost prompt_tokens completion_tokens
      let tokens ← sat_add prompt_tokens completion_tokens
      let ws ←
        alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.DelReservation id)
      let ws1 ←
        if r.key_id != 0#u64
        then
          do
          let o1 ← find_key s.keys r.key_id
          match o1 with
          | none => ok ws
          | some k =>
            let k2 ← key_now k a.now
            let i ← sat_add k2.spend c
            let ws2 ←
              alloc.vec.Vec.push ws (Write.PutKey { k2 with spend := i })
            let u ← count_tokens s.usage SCOPE_KEY k.id w tokens
            alloc.vec.Vec.push ws2 (Write.PutUsage u)
        else ok ws
      let ws2 ←
        if r.team != 0#u64
        then
          do
          let o1 ← find_team s.teams r.team
          match o1 with
          | none => ok ws1
          | some t =>
            let t2 ← team_now t a.now
            let i ← sat_add t2.spend c
            let ws3 ←
              alloc.vec.Vec.push ws1 (Write.PutTeam { t2 with spend := i })
            let u ← count_tokens s.usage SCOPE_TEAM t.id w tokens
            alloc.vec.Vec.push ws3 (Write.PutUsage u)
        else ok ws1
      let u ← count_tokens s.usage SCOPE_DEPLOYMENT r.deployment w tokens
      let ws3 ← alloc.vec.Vec.push ws2 (Write.PutUsage u)
      let b1 ←
        CallStatus.Insts.CoreCmpPartialEqCallStatus.eq status
          CallStatus.Retryable
      let ws4 ←
        if b1
        then
          do
          let o1 ← find_deployment s.deployments r.deployment
          match o1 with
          | none => ok ws3
          | some d =>
            let d1 ←
              record_failure d s.settings.allowed_fails
                s.settings.cooldown_secs a.now
            alloc.vec.Vec.push ws3 (Write.PutDeployment d1)
        else ok ws3
      let ws5 ←
        alloc.vec.Vec.push ws4 (Write.Emit
          {
            reservation := id,
            key := r.key_id,
            team := r.team,
            deployment := r.deployment,
            model := r.model,
            prompt_tokens,
            completion_tokens,
            cost := c,
            «at» := a.now,
            status
          })
      ok (core.result.Result.Ok (ws5, Reply.Settled c))
    else ok (core.result.Result.Err Error.Forbidden)

