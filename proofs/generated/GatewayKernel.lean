def is_admin (a : Principal) (s : Snapshot) : Result Bool := do
  if a.master
  then ok true
  else
    let o ← find_key s.keys a.key
    match o with
    | none => ok false
    | some k =>
      if k.admin
      then if k.blocked
           then ok false
           else ok (a.now < k.expires_at)
      else ok false

/-- [gateway_kernel::may_call]:
    Source: 'kernel/src/lib.rs', lines 751:0-767:1
    Visibility: public -/
def may_call
  (s : Snapshot) (k : Key) (t : Option Team) (model : Std.U64) :
  Result Bool
  := do
  if k.all_models
  then
    match t with
    | none => ok true
    | some team =>
      if team.all_models
      then ok true
      else team_may s.team_models team.id model
  else
    let b ← key_may s.key_models k.id model
    if b
    then
      match t with
      | none => ok true
      | some team =>
        if team.all_models
        then ok true
        else team_may s.team_models team.id model
    else ok false

