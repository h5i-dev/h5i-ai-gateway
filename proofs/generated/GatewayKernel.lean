def apply_write (s : Snapshot) (w : Write) : Result Snapshot := do
  match w with
  | Write.SetSettings x => ok { s with settings := x }
  | Write.PutTeam x => let v ← Team.put s.teams x
                       ok { s with teams := v }
  | Write.DelTeam id => let v ← Team.del s.teams id
                        ok { s with teams := v }
  | Write.PutKey x => let v ← Key.put s.keys x
                      ok { s with keys := v }
  | Write.DelKey id => let v ← Key.del s.keys id
                       ok { s with keys := v }
  | Write.PutModel x =>
    let v ← Model.put s.models x
    ok { s with models := v }
  | Write.PutDeployment x =>
    let v ← Deployment.put s.deployments x
    ok { s with deployments := v }
  | Write.DelDeployment id =>
    let v ← Deployment.del s.deployments id
    ok { s with deployments := v }
  | Write.PutKeyModel x =>
    let v ← KeyModel.put s.key_models x
    ok { s with key_models := v }
  | Write.DelKeyModel k m =>
    let v ← KeyModel.del s.key_models k m
    ok { s with key_models := v }
  | Write.PutTeamModel x =>
    let v ← TeamModel.put s.team_models x
    ok { s with team_models := v }
  | Write.DelTeamModel t m =>
    let v ← TeamModel.del s.team_models t m
    ok { s with team_models := v }
  | Write.PutUsage x => let v ← Usage.put s.usage x
                        ok { s with usage := v }
  | Write.PutReservation x =>
    let v ← Reservation.put s.reservations x
    ok { s with reservations := v }
  | Write.DelReservation id =>
    let v ← Reservation.del s.reservations id
    ok { s with reservations := v }
  | Write.Emit _ => ok s

