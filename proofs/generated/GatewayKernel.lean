/-- [gateway_kernel::record_failure]:
    Source: 'kernel/src/lib.rs', lines 722:0-734:1
    Visibility: public -/
def record_failure
  (d : Deployment) (allowed_fails : Std.U64) (cooldown_secs : Std.U64)
  (now : Std.U64) :
  Result Deployment
  := do
  let w ← window_of now
  let fails ← if d.fail_window = w
                then sat_add d.fails 1#u64
                else ok 1#u64
  if fails > allowed_fails
  then
    let i ← sat_add now cooldown_secs
    ok { d with fails := 0#u64, fail_window := w, cooldown_until := i }
  else ok { d with fails, fail_window := w }

