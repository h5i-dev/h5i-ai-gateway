/-! ## Tables -/

/-- Key length per table. -/
def kl : Nat → Nat
  | 0 => 0
  | 1 => 1
  | 2 => 1
  | 3 => 1
  | 4 => 1
  | 5 => 2
  | 6 => 2
  | 7 => 2
  | 8 => 1
  | _ => 0

@[simp] theorem kl_0 : kl 0 = 0 := rfl
@[simp] theorem kl_1 : kl 1 = 1 := rfl
@[simp] theorem kl_2 : kl 2 = 1 := rfl
@[simp] theorem kl_3 : kl 3 = 1 := rfl
@[simp] theorem kl_4 : kl 4 = 1 := rfl
@[simp] theorem kl_5 : kl 5 = 2 := rfl
@[simp] theorem kl_6 : kl 6 = 2 := rfl
@[simp] theorem kl_7 : kl 7 = 2 := rfl
@[simp] theorem kl_8 : kl 8 = 1 := rfl

/-- `row` encodes a value of table `t`'s row type. -/
def IsRow : Nat → List Val → Prop
  | 0 => fun r => ∃ x : Settings, r = Settings.row x
  | 1 => fun r => ∃ x : Team, r = Team.row x
  | 2 => fun r => ∃ x : Key, r = Key.row x
  | 3 => fun r => ∃ x : Model, r = Model.row x
  | 4 => fun r => ∃ x : Deployment, r = Deployment.row x
  | 5 => fun r => ∃ x : KeyModel, r = KeyModel.row x
  | 6 => fun r => ∃ x : TeamModel, r = TeamModel.row x
  | 7 => fun r => ∃ x : Usage, r = Usage.row x
  | 8 => fun r => ∃ x : Reservation, r = Reservation.row x
  | _ => fun _ => False

/-- Split a goal about table `t` into one goal per table. -/
macro "cases_table " t:ident : tactic => `(tactic| rcases $t:ident with _ | _ | _ | _ | _ | _ | _ | _ | _ | $t:ident)

/-- A write's table writes map a state's encoding to the next: `schema_step [enc, sqlA, applyWrite]`. -/
macro "schema_step" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro s w; funext t
  cases w <;> cases_table t <;>
    simp [applyAllW, applyW, upsert, Settings.putA, Settings.table, Settings.keyLen, Settings.row, Team.putA, Team.table, Team.keyLen, Team.delA, Team.delWhereA, Key.putA, Key.table, Key.keyLen, Key.delA, Key.delWhereA, Model.putA, Model.table, Model.keyLen, Model.delA, Model.delWhereA, Deployment.putA, Deployment.table, Deployment.keyLen, Deployment.delA, Deployment.delWhereA, KeyModel.putA, KeyModel.table, KeyModel.keyLen, KeyModel.delA, KeyModel.delWhereA, TeamModel.putA, TeamModel.table, TeamModel.keyLen, TeamModel.delA, TeamModel.delWhereA, Usage.putA, Usage.table, Usage.keyLen, Usage.delA, Usage.delWhereA, Reservation.putA, Reservation.table, Reservation.keyLen, Reservation.delA, Reservation.delWhereA, $ls,*] <;>
    first
      | exact map_filter_of _ _ _ _ (fun y => by simp [Settings.row, Team.row, Key.row, Model.row, Deployment.row, KeyModel.row, TeamModel.row, Usage.row, Reservation.row])
      | (congr 1; exact List.filter_congr (fun y _ => by simp [Settings.row, Team.row, Key.row, Model.row, Deployment.row, KeyModel.row, TeamModel.row, Usage.row, Reservation.row]))))

/-- Every table write is well formed: `schema_ok [sqlA]`. -/
macro "schema_ok" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro w; cases w <;>
    simp [WriteOk, RowOk, IsRow, Settings.putA, Settings.table, Settings.keyLen, Team.putA, Team.table, Team.keyLen, Team.delA, Team.delWhereA, Key.putA, Key.table, Key.keyLen, Key.delA, Key.delWhereA, Model.putA, Model.table, Model.keyLen, Model.delA, Model.delWhereA, Deployment.putA, Deployment.table, Deployment.keyLen, Deployment.delA, Deployment.delWhereA, KeyModel.putA, KeyModel.table, KeyModel.keyLen, KeyModel.delA, KeyModel.delWhereA, TeamModel.putA, TeamModel.table, TeamModel.keyLen, TeamModel.delA, TeamModel.delWhereA, Usage.putA, Usage.table, Usage.keyLen, Usage.delA, Usage.delWhereA, Reservation.putA, Reservation.table, Reservation.keyLen, Reservation.delA, Reservation.delWhereA, $ls,*]))

/-- A fresh tenant's tables: `schema_init [enc, init]`. -/
macro "schema_init" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t; cases_table t <;> simp [InitOk, $ls,*]))

/-- A fresh tenant's rows are rows of their tables: `schema_rows [enc, init]`. -/
macro "schema_rows" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t r h; cases_table t <;> simp [$ls,*] at h <;> subst h <;> first | exact ⟨Settings.zero, rfl⟩))

/-! ## The snapshot -/

/-- A snapshot's rows, table by table. -/
def Snapshot.enc (s : Snapshot) : Tables Val
  | 0 => [Settings.row s.settings]
  | 1 => s.teams.val.map Team.row
  | 2 => s.keys.val.map Key.row
  | 3 => s.models.val.map Model.row
  | 4 => s.deployments.val.map Deployment.row
  | 5 => s.key_models.val.map KeyModel.row
  | 6 => s.team_models.val.map TeamModel.row
  | 7 => s.usage.val.map Usage.row
  | 8 => s.reservations.val.map Reservation.row
  | _ => []

/-- A fresh tenant's snapshot. -/
def Snapshot.empty : Snapshot :=
  { settings := Settings.zero, teams := alloc.vec.Vec.new Team, keys := alloc.vec.Vec.new Key, models := alloc.vec.Vec.new Model, deployments := alloc.vec.Vec.new Deployment, key_models := alloc.vec.Vec.new KeyModel, team_models := alloc.vec.Vec.new TeamModel, usage := alloc.vec.Vec.new Usage, reservations := alloc.vec.Vec.new Reservation }

/-- Stored rows, table by table. -/
def Rows.tabs (r : Rows) : Tables Val
  | 0 => r.settings.val.map (·.val)
  | 1 => r.teams.val.map (·.val)
  | 2 => r.keys.val.map (·.val)
  | 3 => r.models.val.map (·.val)
  | 4 => r.deployments.val.map (·.val)
  | 5 => r.key_models.val.map (·.val)
  | 6 => r.team_models.val.map (·.val)
  | 7 => r.usage.val.map (·.val)
  | 8 => r.reservations.val.map (·.val)
  | _ => []

theorem Snapshot.clone_eq (s : Snapshot) : Snapshot.Insts.CoreCloneClone.clone s = ok s := by
  simp [Snapshot.Insts.CoreCloneClone.clone,
    Settings.clone_eq,
    vec_clone_eq Team.Insts.CoreCloneClone s.teams Team.clone_eq,
    vec_clone_eq Key.Insts.CoreCloneClone s.keys Key.clone_eq,
    vec_clone_eq Model.Insts.CoreCloneClone s.models Model.clone_eq,
    vec_clone_eq Deployment.Insts.CoreCloneClone s.deployments Deployment.clone_eq,
    vec_clone_eq KeyModel.Insts.CoreCloneClone s.key_models KeyModel.clone_eq,
    vec_clone_eq TeamModel.Insts.CoreCloneClone s.team_models TeamModel.clone_eq,
    vec_clone_eq Usage.Insts.CoreCloneClone s.usage Usage.clone_eq,
    vec_clone_eq Reservation.Insts.CoreCloneClone s.reservations Reservation.clone_eq]

/-- `decode` reads back tables `E` up to row order (an empty singleton table reads as its fresh row). -/
theorem decode_spec (r : Rows) (E : Tables Val)
    (hrow : ∀ t, ∀ row ∈ E t, IsRow t row)
    (hone0 : (E 0).length = 1)
    (hnil : ∀ t, 9 ≤ t → E t = [])
    (hR : ∀ t, (Rows.tabs r t).Perm (E t) ∨ (Rows.tabs r t = [] ∧ E t = Snapshot.enc Snapshot.empty t)) :
    decode r ⦃ o => ∃ s, o = some s ∧ ∀ t, (Snapshot.enc s t).Perm (E t) ⦄ := by
  obtain ⟨l0, n0, e0, f0⟩ := one_row Settings.row Settings.zero (Rows.tabs r 0) (E 0) hone0 (hrow 0) (hR 0)
  have h1 : (Rows.tabs r 1).Perm (E 1) := keyed_perm (hR 1)
  obtain ⟨l1, e1⟩ := exists_map Team.row (Rows.tabs r 1) (fun row h => hrow 1 row (h1.subset h))
  have h2 : (Rows.tabs r 2).Perm (E 2) := keyed_perm (hR 2)
  obtain ⟨l2, e2⟩ := exists_map Key.row (Rows.tabs r 2) (fun row h => hrow 2 row (h2.subset h))
  have h3 : (Rows.tabs r 3).Perm (E 3) := keyed_perm (hR 3)
  obtain ⟨l3, e3⟩ := exists_map Model.row (Rows.tabs r 3) (fun row h => hrow 3 row (h3.subset h))
  have h4 : (Rows.tabs r 4).Perm (E 4) := keyed_perm (hR 4)
  obtain ⟨l4, e4⟩ := exists_map Deployment.row (Rows.tabs r 4) (fun row h => hrow 4 row (h4.subset h))
  have h5 : (Rows.tabs r 5).Perm (E 5) := keyed_perm (hR 5)
  obtain ⟨l5, e5⟩ := exists_map KeyModel.row (Rows.tabs r 5) (fun row h => hrow 5 row (h5.subset h))
  have h6 : (Rows.tabs r 6).Perm (E 6) := keyed_perm (hR 6)
  obtain ⟨l6, e6⟩ := exists_map TeamModel.row (Rows.tabs r 6) (fun row h => hrow 6 row (h6.subset h))
  have h7 : (Rows.tabs r 7).Perm (E 7) := keyed_perm (hR 7)
  obtain ⟨l7, e7⟩ := exists_map Usage.row (Rows.tabs r 7) (fun row h => hrow 7 row (h7.subset h))
  have h8 : (Rows.tabs r 8).Perm (E 8) := keyed_perm (hR 8)
  obtain ⟨l8, e8⟩ := exists_map Reservation.row (Rows.tabs r 8) (fun row h => hrow 8 row (h8.subset h))
  unfold decode
  step with Settings.from_one_spec r.settings l0 n0 e0 as ⟨ o0, h0 ⟩
  subst h0; dsimp only
  step with Team.from_rows_spec r.teams l1 e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Key.from_rows_spec r.keys l2 e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  step with Model.from_rows_spec r.models l3 e3 as ⟨ o3, v3, ho3, hv3 ⟩
  subst ho3; dsimp only
  step with Deployment.from_rows_spec r.deployments l4 e4 as ⟨ o4, v4, ho4, hv4 ⟩
  subst ho4; dsimp only
  step with KeyModel.from_rows_spec r.key_models l5 e5 as ⟨ o5, v5, ho5, hv5 ⟩
  subst ho5; dsimp only
  step with TeamModel.from_rows_spec r.team_models l6 e6 as ⟨ o6, v6, ho6, hv6 ⟩
  subst ho6; dsimp only
  step with Usage.from_rows_spec r.usage l7 e7 as ⟨ o7, v7, ho7, hv7 ⟩
  subst ho7; dsimp only
  step with Reservation.from_rows_spec r.reservations l8 e8 as ⟨ o8, v8, ho8, hv8 ⟩
  subst ho8; dsimp only
  refine ⟨_, rfl, fun t => ?_⟩
  match t with
  | 0 => simp only [Snapshot.enc, f0]; exact .refl _
  | 1 => simp only [Snapshot.enc, hv1]; rw [← e1]; exact h1
  | 2 => simp only [Snapshot.enc, hv2]; rw [← e2]; exact h2
  | 3 => simp only [Snapshot.enc, hv3]; rw [← e3]; exact h3
  | 4 => simp only [Snapshot.enc, hv4]; rw [← e4]; exact h4
  | 5 => simp only [Snapshot.enc, hv5]; rw [← e5]; exact h5
  | 6 => simp only [Snapshot.enc, hv6]; rw [← e6]; exact h6
  | 7 => simp only [Snapshot.enc, hv7]; rw [← e7]; exact h7
  | 8 => simp only [Snapshot.enc, hv8]; rw [← e8]; exact h8
  | t + 9 => simp only [Snapshot.enc, hnil (t + 9) (by omega)]; exact .refl _

/-! ## Partial loads

`Store::load_for` may load each table by one declarative read of a plan
(`schema_load_plan`). `Snapshot.load plan s` is what loading `plan` from the
tables of `s` decodes to (`decode_load`); an app's frame theorem shows
`transition` gives the same result on it as on `s`. Values compare by
classical equality, as everywhere in this file. -/

section PartialLoads
open H5iAppLib.Query

/-- A vector's rows that the plan loads. -/
noncomputable def pickVec {α : Type} (plan : List (Query.Read Val)) (tabs : Tables Val) (t : Nat) (row : α → List Val)
    (v : alloc.vec.Vec α) : alloc.vec.Vec α :=
  .from (pickRows plan tabs t row v.val) ((pickRows_length plan tabs t row v.val).trans v.len_ineq)

/-- What loading `plan` from the tables of `s` decodes to: each table's rows its read keeps, none if the plan
does not read it; a singleton table reads as fresh unless its read keeps its row. -/
noncomputable def Snapshot.load (plan : List (Query.Read Val)) (s : Snapshot) : Snapshot :=
  { settings := (pickRows plan (Snapshot.enc s) 0 Settings.row [s.settings]).headD Settings.zero, teams := pickVec plan (Snapshot.enc s) 1 Team.row s.teams, keys := pickVec plan (Snapshot.enc s) 2 Key.row s.keys, models := pickVec plan (Snapshot.enc s) 3 Model.row s.models, deployments := pickVec plan (Snapshot.enc s) 4 Deployment.row s.deployments, key_models := pickVec plan (Snapshot.enc s) 5 KeyModel.row s.key_models, team_models := pickVec plan (Snapshot.enc s) 6 TeamModel.row s.team_models, usage := pickVec plan (Snapshot.enc s) 7 Usage.row s.usage, reservations := pickVec plan (Snapshot.enc s) 8 Reservation.row s.reservations }

@[simp] theorem Snapshot.load_teams (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).teams.val = pickRows plan (Snapshot.enc s) 1 Team.row s.teams.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_keys (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).keys.val = pickRows plan (Snapshot.enc s) 2 Key.row s.keys.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_models (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).models.val = pickRows plan (Snapshot.enc s) 3 Model.row s.models.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_deployments (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).deployments.val = pickRows plan (Snapshot.enc s) 4 Deployment.row s.deployments.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_key_models (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).key_models.val = pickRows plan (Snapshot.enc s) 5 KeyModel.row s.key_models.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_team_models (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).team_models.val = pickRows plan (Snapshot.enc s) 6 TeamModel.row s.team_models.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_usage (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).usage.val = pickRows plan (Snapshot.enc s) 7 Usage.row s.usage.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_reservations (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).reservations.val = pickRows plan (Snapshot.enc s) 8 Reservation.row s.reservations.val :=
  alloc.vec.Vec.from_val _ _


/-- Rows holding, for each table, what `plan` loads from the tables of `s` decode to `Snapshot.load plan s`. -/
theorem decode_load (plan : List (Query.Read Val)) (s : Snapshot) (r : Rows)
    (h : ∀ t, t < 9 → Rows.tabs r t = load plan (Snapshot.enc s) t) :
    decode r = ok (some (Snapshot.load plan s)) := by
  have e0 := h 0 (by omega)
  rw [load_pick plan _ 0 Settings.row [s.settings] rfl] at e0
  have hl0 := pickRows_length plan (Snapshot.enc s) 0 Settings.row [s.settings]
  have e1 := h 1 (by omega)
  rw [load_pick plan _ 1 Team.row s.teams.val rfl] at e1
  have e2 := h 2 (by omega)
  rw [load_pick plan _ 2 Key.row s.keys.val rfl] at e2
  have e3 := h 3 (by omega)
  rw [load_pick plan _ 3 Model.row s.models.val rfl] at e3
  have e4 := h 4 (by omega)
  rw [load_pick plan _ 4 Deployment.row s.deployments.val rfl] at e4
  have e5 := h 5 (by omega)
  rw [load_pick plan _ 5 KeyModel.row s.key_models.val rfl] at e5
  have e6 := h 6 (by omega)
  rw [load_pick plan _ 6 TeamModel.row s.team_models.val rfl] at e6
  have e7 := h 7 (by omega)
  rw [load_pick plan _ 7 Usage.row s.usage.val rfl] at e7
  have e8 := h 8 (by omega)
  rw [load_pick plan _ 8 Reservation.row s.reservations.val rfl] at e8
  simp only [Rows.tabs] at *
  apply eq_ok_of_spec
  unfold decode
  step with Settings.from_one_spec r.settings _ hl0 e0 as ⟨ o0, h0 ⟩
  subst h0; dsimp only
  step with Team.from_rows_spec r.teams _ e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Key.from_rows_spec r.keys _ e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  step with Model.from_rows_spec r.models _ e3 as ⟨ o3, v3, ho3, hv3 ⟩
  subst ho3; dsimp only
  step with Deployment.from_rows_spec r.deployments _ e4 as ⟨ o4, v4, ho4, hv4 ⟩
  subst ho4; dsimp only
  step with KeyModel.from_rows_spec r.key_models _ e5 as ⟨ o5, v5, ho5, hv5 ⟩
  subst ho5; dsimp only
  step with TeamModel.from_rows_spec r.team_models _ e6 as ⟨ o6, v6, ho6, hv6 ⟩
  subst ho6; dsimp only
  step with Usage.from_rows_spec r.usage _ e7 as ⟨ o7, v7, ho7, hv7 ⟩
  subst ho7; dsimp only
  step with Reservation.from_rows_spec r.reservations _ e8 as ⟨ o8, v8, ho8, hv8 ⟩
  subst ho8; dsimp only
  simp only [WP.spec_ok, Option.some.injEq, Snapshot.load]
  congr 1 <;> apply alloc.vec.Vec.ext <;> simp [pickVec, *]

/-- `IN` a column of a read of table 0, as a test on the snapshot's rows. -/
theorem holds_in_0 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 0 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply (([s.settings]).filter (fun y => p.holds (Snapshot.enc s) (Settings.row y)))).any
          (fun y => decide ((Settings.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 0) (j := j) (p := p) (w := w) (r := r) (f := Settings.row)
    (l := [s.settings]) (h := rfl)]
  cases r[i]? <;> rfl

