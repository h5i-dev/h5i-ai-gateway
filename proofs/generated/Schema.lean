theorem Settings.from_one_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Settings)
    (hl : l.length ≤ 1) (h : rows.val.map (·.val) = l.map Settings.row) :
    Settings.from_one rows ⦃ o => o = some (l.headD Settings.zero) ⦄ := by
  unfold Settings.from_one
  match l, hl with
  | [], _ =>
    have hr : rows.val = [] := by simpa using h
    have h0 : rows.len = 0#usize := by scalar_tac
    rw [if_pos h0]; step*; simp_all [Settings.zero]
  | [x], _ =>
    obtain ⟨v, hv, hvv⟩ : ∃ v, rows.val = [v] ∧ v.val = Settings.row x := by
      simp only [List.map_cons, List.map_nil] at h
      obtain ⟨v, rest⟩ := List.map_eq_singleton_iff.1 h
      exact ⟨v, rest.1, rest.2⟩
    have h0 : ¬ rows.len = 0#usize := by scalar_tac
    have h1 : rows.len = 1#usize := by scalar_tac
    rw [if_neg h0, if_pos h1]
    step as ⟨ w, hw ⟩
    have : w.val = Settings.row x := by rw [hw]; simp [hv, hvv]
    step with Settings.from_row_spec x w this
    simp_all

theorem Team.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Team)
    (h : rows.val.map (·.val) = l.map Team.row) :
    Team.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Team.from_rows_loop rows (alloc.vec.Vec.new Team) true 0#usize =
      loop (fun x => rowsBody Team.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Team, true, 0#usize) := by
    unfold Team.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Team.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Team.from_rows_loop rows (alloc.vec.Vec.new Team) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Team.from_row Team.row (fun x v hv => Team.from_row_spec x v hv) rows l h
  unfold Team.from_rows
  step with hl
  simp [ok1_post, l_post]

