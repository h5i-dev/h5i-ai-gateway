import Commands
/-!
# What a read plan loads

`read_plan a c` (extracted) names one declarative read per table; the server
loads each table by its read (`schema_load_plan`) and `decode`s. Here the
extracted reads are read as `H5iAppLib.Query` reads (`Read.abs`, `readsA`,
`reads_abs`). What loading a plan decodes to, `Snapshot.load plan s`, and
its `decode_load` are generated by `schema!` (`generated/Schema.lean`).
`Frame.lean` shows `transition` gives the same result on
`Snapshot.load (readsA a c) s` as on `s`.

Trusted: PostgreSQL returns, for each read, `Read.rows` of the tenant's
tables listed in key order (the order `load` returns them in), which the
differential tests of `h5i_app_pgsql::compile_read` check, in both of its
SQL modes (the server uses `ScalarWhenUnique`).
-/
open Aeneas Aeneas.Std Result gateway_kernel gateway_kernel.Schema gateway_kernel.Helpers H5iAppLib

namespace gateway_kernel.Plan

open H5iAppLib.Query

def Window.abs (w : h5i_app_sql.Window) : Window := ⟨w.desc, w.offset.val, w.limit.map (·.val)⟩

def Pred.abs : h5i_app_sql.Pred → Pred Val
  | .All => .all
  | .Eq c v => .eq c.val v
  | .In c t p o w => .isIn c.val t.val (Pred.abs p) o.val (Window.abs w)
  | .And p q => .and (Pred.abs p) (Pred.abs q)
  | .Or p q => .or (Pred.abs p) (Pred.abs q)

def Read.abs (r : h5i_app_sql.Read) : Read Val := ⟨r.table.val, Pred.abs r.pred, Window.abs r.window⟩

/-- The plan of `read_plan a c`, if any, as `H5iAppLib.Query` reads. -/
def planOf (o : Option (alloc.vec.Vec h5i_app_sql.Read)) : Option (List (Read Val)) :=
  o.map (fun v => v.val.map Read.abs)

/-! ## The plans, written out

Tables and columns are numbered as in `schema!`: settings 0, teams 1 (id,
...), keys 2 (id, team, ...), models 3 (id, name), deployments 4, key grants
5 (key, model), team grants 6 (team, model), usage 7 (scope, id, ...),
reservations 8 (id, key_id, team, ...). -/

/-- No row: the first column is never both 0 and 1. -/
def noneA : Pred Val := .and (.eq 0 (int 0)) (.eq 0 (int 1))

/-- Column `c` names the id `x` as `via` says (`p_arm`). -/
def viaA (c : Nat) : Via → U64 → Pred Val
  | .Id, x => .eq c (int x.val)
  | .Row t o, x => .isIn c t.val (.eq 0 (int x.val)) o.val {}
  | .TeamOfKey, x => .isIn c 1 (.isIn 0 2 (.eq 0 (int x.val)) 1 {}) 0 {}

/-- One arm: `viaA`, in usage counters of scope `sc` if given. -/
def armA (c : Nat) (scope : Option U64) (via : Via) (x : U64) : Pred Val :=
  match scope with
  | none => viaA c via x
  | some sc => .and (.eq 0 (int sc.val)) (viaA c via x)

/-- `p`, or one arm per id (`p_arms`). -/
def armsA (p : Pred Val) (c : Nat) (scope : Option U64) (via : Via) (ids : List U64) : Pred Val :=
  ids.foldl (fun q x => .or q (armA c scope via x)) p

/-- A model named one of `names` (`p_names`). -/
def namesA (names : List (alloc.vec.Vec U8)) : Pred Val :=
  names.foldl (fun q n => .or q (.eq 1 (.Bytes n))) noneA

def resKey : Via := .Row 8#u32 1#u32
def resTeam : Via := .Row 8#u32 RES_TEAM
def keyTeam : Via := .Row 2#u32 1#u32
def teamRow : Via := .Row 1#u32 0#u32

def keysA (keys res : List U64) : Pred Val := armsA (armsA noneA 0 none .Id keys) 0 none resKey res

def teamsA (keys teams res : List U64) : Pred Val :=
  armsA (armsA (armsA noneA 0 none .Id teams) 0 none keyTeam keys) 0 none resTeam res

def teamModelsA (keys teams : List U64) : Pred Val := armsA (armsA noneA 0 none .Id teams) 0 none keyTeam keys

def usageA (keys teams res : List U64) : Pred Val :=
  armsA (armsA (armsA (armsA (armsA (.eq 0 (int 2)) 1 (some 0#u64) .Id keys) 1 (some 0#u64) resKey res)
    1 (some 1#u64) .Id teams) 1 (some 1#u64) keyTeam keys) 1 (some 1#u64) resTeam res

def reservationsA (keys teams res : List U64) (m0 : Bool) : Pred Val :=
  armsA (armsA (armsA (armsA (if m0 then .eq 1 (int 0) else noneA) 1 none .Id keys) RES_TEAM.val none teamRow teams)
    RES_TEAM.val none .TeamOfKey keys) 0 none .Id res

/-- `plan_of`: the reads of a command that looks at the keys `keys`, the teams
`teams`, the reservations `res` and the models `names` (all if `allm`). -/
def planA (keys teams res : List U64) (names : List (alloc.vec.Vec U8)) (m0 allm : Bool) : List (Read Val) :=
  [⟨0, .all, {}⟩, ⟨1, teamsA keys teams res, {}⟩, ⟨2, keysA keys res, {}⟩,
    ⟨3, if allm then .all else namesA names, {}⟩, ⟨4, .all, {}⟩, ⟨5, armsA noneA 0 none .Id keys, {}⟩,
    ⟨6, teamModelsA keys teams, {}⟩, ⟨7, usageA keys teams res, {}⟩, ⟨8, reservationsA keys teams res m0, {}⟩]

/-- `add_id`. -/
def addId (l : List U64) (x : U64) : List U64 := if x ∈ l then l else l ++ [x]

/-- `add_name`. -/
def addName (l : List (alloc.vec.Vec U8)) (n : alloc.vec.Vec U8) : List (alloc.vec.Vec U8) :=
  if l.any (fun m => decide (m.val = n.val)) then l else l ++ [n]

/-- What a batch reads, gathered over its items (`batch_plan`). -/
structure Wants where
  keys : List U64
  res : List U64
  names : List (alloc.vec.Vec U8)
  m0 : Bool

def wantStep (w : Wants) (it : BatchItem) : Wants :=
  let keys := if it.master then w.keys else addId w.keys it.key
  match it.op with
  | .Admit m _ _ _ => ⟨keys, w.res, addName w.names m, it.master || w.m0⟩
  | .Settle r _ _ _ => ⟨keys, addId w.res r, w.names, w.m0⟩

def wantsA (items : List BatchItem) : Wants := items.foldl wantStep ⟨[], [], [], false⟩

/-- `caller_keys`. -/
def callerA (a : Principal) : List U64 := if a.master then [] else [a.key]

/-- `read_plan`, as `H5iAppLib.Query` reads. -/
def readsA (a : Principal) : Command → Option (List (Read Val))
  | .Admit m _ _ _ => some (planA (callerA a) [] [] [m] false false)
  | .Settle r _ _ _ => some (planA (callerA a) [] [r] [] false false)
  | .Expire r => some (planA (callerA a) [] [r] [] false false)
  | .KeyInfo id => some (planA (callerA a ++ [id]) [] [] [] false false)
  | .TeamInfo id => some (planA (callerA a) [id] [] [] false false)
  | .ListModels => some (planA (callerA a) [] [] [] false true)
  | .Batch items => some (planA (wantsA items.val).keys [] (wantsA items.val).res (wantsA items.val).names
      (wantsA items.val).m0 false)
  | _ => none

/-! ## Loops over a vector

A loop over the elements of a vector is a monadic fold of its step
(`loop_foldlM`). -/

theorem succ_ok (i : Usize) (n : Nat) (h : i.val < n) (hn : n ≤ Usize.max) :
    ∃ i2 : Usize, i + 1#usize = ok i2 ∧ i2.val = i.val + 1 := by
  obtain ⟨i2, h1, h2⟩ := (WP.spec_equiv_exists _ _).1 (Usize.add_spec (x := i) (y := 1#usize) (by scalar_tac))
  exact ⟨i2, h1, by scalar_tac⟩

/-- A loop that runs a step over each element of `v` from index `i`
computes the monadic fold of the step over the rest of `v`. -/
theorem loop_foldlM {α β γ σ : Type} (v : List α) (hv : v.length ≤ Usize.max) (step : β → α → Result β)
    (fin : β → γ) (mk : β → Usize → σ) (body : σ → Result (ControlFlow σ γ))
    (hbody : ∀ a (i : Usize), i.val ≤ v.length → body (mk a i) = if h : i.val < v.length then
      (do let a' ← step a v[i.val]; let i2 ← i + 1#usize; ok (ControlFlow.cont (mk a' i2)))
      else ok (ControlFlow.done (fin a))) :
    ∀ a (i : Usize), i.val ≤ v.length →
      loop body (mk a i) = (do let a' ← (v.drop i.val).foldlM step a; ok (fin a')) := by
  intro a i
  induction h : v.length - i.val using Nat.strong_induction_on generalizing a i with
  | _ n ih =>
    intro hi
    rw [loop, hbody a i hi]
    split
    · rename_i hlt
      rw [List.drop_eq_getElem_cons hlt, List.foldlM_cons]
      simp only [bind_tc_eq, Std.bind_assoc]
      congr 1; funext a'
      obtain ⟨i2, hi2, hv2⟩ := succ_ok i v.length hlt hv
      rw [hi2]; simp only [bind_ok]
      rw [ih (v.length - i2.val) (by omega) a' i2 rfl (by omega), hv2]
    · rename_i hge
      have : i.val = v.length := by omega
      simp only [this, List.drop_length, List.foldlM_nil, pure_tc_eq, bind_ok]

theorem vec_index_eq {α : Type} (v : alloc.vec.Vec α) (i : Usize) (h : i.val < v.val.length) :
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice α) v i = ok v.val[i.val] := by
  rw [alloc.vec.Vec.index_slice_index]; unfold alloc.vec.Vec.index_usize
  simp [h]

theorem lt_len_iff {α : Type} (v : alloc.vec.Vec α) (i : Usize) : i < alloc.vec.Vec.len v ↔ i.val < v.val.length := by
  simp [alloc.vec.Vec.len]

/-- Unfolds a loop body over `v` to the shape `loop_foldlM` takes. -/
macro "body_shape" v:term:max : tactic => `(tactic| (
  by_cases hlt : (‹Usize›).val < ($v).val.length
  · simp only [(lt_len_iff _ _).2 hlt, vec_index_eq _ _ hlt, dif_pos hlt, if_true, bind_tc_eq, bind_ok, Std.bind_assoc]
    try rfl
  · simp only [mt (lt_len_iff _ _).1 hlt, dif_neg hlt, if_false]
    try rfl))

theorem foldlM_abs {α β γ : Type} (step : β → α → Result β) (F : β → γ) (g : γ → α → γ)
    (hs : ∀ a x r, step a x = ok r → F r = g (F a) x) :
    ∀ (l : List α) (a r : β), l.foldlM step a = ok r → F r = l.foldl g (F a) := by
  intro l
  induction l with
  | nil => intro a r h; simp only [List.foldlM_nil, pure_tc_eq, ok.injEq] at h; subst h; rfl
  | cons x xs ih =>
    intro a r h
    simp only [List.foldlM_cons] at h
    obtain ⟨a1, h1, h2⟩ := bind_tc_eq_ok.1 h
    rw [ih _ _ h2, hs _ _ _ h1]; rfl

/-! ## The builders -/

theorem bytes_eq (v : alloc.vec.Vec U8) : alloc.vec.VecU8.Insts.H5i_app_sqlColumn.to_val v = ok (.Bytes v) :=
  eq_ok_of_spec (bytes_to_val v)

/-- Unfolds the predicate builders. -/
macro "plan_simp" l:(Lean.Parser.Tactic.location)? : tactic => `(tactic| simp [rd, p_none, p_in, p_eq, p_or, p_and,
  v_int, v_bytes, u64_to_val_eq, bytes_eq, h5i_app_sql.whole, Pred.abs, Window.abs, Read.abs, noneA, viaA, armA,
  T_SETTINGS, T_TEAMS, T_KEYS, T_MODELS, T_DEPLOYMENTS, T_KEY_MODELS, T_TEAM_MODELS, T_USAGE, T_RESERVATIONS,
  COL_FIRST, KEY_TEAM, MODEL_NAME, USAGE_ID, RES_KEY, RES_TEAM, SCOPE_KEY, SCOPE_TEAM, SCOPE_DEPLOYMENT,
  U32.max, U32.numBits] $[$l]?)

theorem p_none_eq : p_none = ok (.And (.Eq 0#u32 (int 0)) (.Eq 0#u32 (int 1))) := by
  plan_simp

theorem p_arm_ok (c : U32) (sc : Option U64) (via : Via) (x : U64) (q : h5i_app_sql.Pred)
    (h : p_arm c sc via x = ok q) : Pred.abs q = armA c.val sc via x := by
  unfold p_arm at h
  cases via <;> cases sc <;> plan_simp at h
  all_goals (try subst h)
  all_goals plan_simp

/-- `p_arms`' step. -/
def armStep (c : U32) (sc : Option U64) (via : Via) (p : h5i_app_sql.Pred) (x : U64) : Result h5i_app_sql.Pred := do
  let p1 ← p_arm c sc via x
  p_or p p1

theorem p_arms_ok (p : h5i_app_sql.Pred) (c : U32) (sc : Option U64) (via : Via) (ids : alloc.vec.Vec U64)
    (q : h5i_app_sql.Pred) (h : p_arms p c sc via ids = ok q) : Pred.abs q = armsA (Pred.abs p) c.val sc via ids.val := by
  have hl : p_arms_loop c sc via ids p 0#usize =
      (do let a ← ids.val.foldlM (armStep c sc via) p; ok a) := by
    unfold p_arms_loop
    have := loop_foldlM ids.val ids.len_ineq (armStep c sc via) id
      (fun a i => (a, i)) (fun x => p_arms_loop.body c sc via ids x.1 x.2) ?_ p 0#usize (by simp)
    · simpa using this
    · intro a i hi
      unfold p_arms_loop.body armStep
      body_shape ids
  simp only [p_arms, hl] at h
  obtain ⟨a1, ha1, e⟩ := bind_tc_eq_ok.1 h
  simp only [ok.injEq] at e; subst e
  have := foldlM_abs _ Pred.abs (fun p x => .or p (armA c.val sc via x)) ?_ _ _ _ ha1
  · exact this
  · intro a x r hr
    unfold armStep at hr
    obtain ⟨p1, hp1, hr⟩ := bind_tc_eq_ok.1 hr
    simp only [p_or, ok.injEq] at hr; subst hr
    simp [Pred.abs, p_arm_ok _ _ _ _ _ hp1]

/-- `p_names`' step. -/
def nameStep (p : h5i_app_sql.Pred) (n : alloc.vec.Vec U8) : Result h5i_app_sql.Pred := do
  let v ← v_bytes n
  let p1 ← p_eq MODEL_NAME v
  p_or p p1

theorem p_names_ok (names : alloc.vec.Vec (alloc.vec.Vec U8)) (q : h5i_app_sql.Pred) (h : p_names names = ok q) :
    Pred.abs q = namesA names.val := by
  have hl : ∀ p0, p_names_loop names p0 0#usize = (do let a ← names.val.foldlM nameStep p0; ok a) := by
    intro p0
    unfold p_names_loop
    have := loop_foldlM names.val names.len_ineq nameStep id
      (fun a i => (a, i)) (fun x => p_names_loop.body names x.1 x.2) ?_ p0 0#usize (by simp)
    · simpa using this
    · intro a i hi
      unfold p_names_loop.body nameStep
      body_shape names
  simp only [p_names, p_none_eq, bind_tc_ok, bind_ok, hl] at h
  obtain ⟨a1, ha1, e⟩ := bind_tc_eq_ok.1 h
  simp only [ok.injEq] at e; subst e
  have := foldlM_abs _ Pred.abs (fun p n => .or p (.eq 1 (.Bytes n))) ?_ _ _ _ ha1
  · rw [this]; simp [namesA, noneA, Pred.abs]
  · intro a x r hr
    unfold nameStep at hr
    plan_simp at hr; subst hr; plan_simp

theorem plan_of_ok (keys teams res : alloc.vec.Vec U64) (names : alloc.vec.Vec (alloc.vec.Vec U8)) (m0 allm : Bool)
    (out : alloc.vec.Vec h5i_app_sql.Read) (h : plan_of keys teams res names m0 allm = ok out) :
    out.val.map Read.abs = planA keys.val teams.val res.val names.val m0 allm := by
  unfold plan_of at h
  rw [p_none_eq] at h
  simp only [bind_tc_ok, bind_ok] at h
  h5i_invert h
  have e1 := p_arms_ok _ _ _ _ _ _ hp1
  have e2 := p_arms_ok _ _ _ _ _ _ hkeys_p
  have e3 := p_arms_ok _ _ _ _ _ _ hp2
  have e4 := p_arms_ok _ _ _ _ _ _ hp3
  have e5 := p_arms_ok _ _ _ _ _ _ hteams_p
  have e6 := p_arms_ok _ _ _ _ _ _ hp4
  have e7 := p_arms_ok _ _ _ _ _ _ hteam_models
  have e8 := p_arms_ok _ _ _ _ _ _ husage1
  have e9 := p_arms_ok _ _ _ _ _ _ husage2
  have e10 := p_arms_ok _ _ _ _ _ _ husage3
  have e11 := p_arms_ok _ _ _ _ _ _ husage4
  have e12 := p_arms_ok _ _ _ _ _ _ husage5
  have e13 := p_arms_ok _ _ _ _ _ _ hreservations1
  have e14 := p_arms_ok _ _ _ _ _ _ hreservations2
  have e15 := p_arms_ok _ _ _ _ _ _ hreservations3
  have e16 := p_arms_ok _ _ _ _ _ _ hreservations4
  have e17 := p_arms_ok _ _ _ _ _ _ hp5
  plan_simp at hv husage hr hr1 hr2 hr3 hr4 hr5 hr6 hr7 hr8
  subst hv husage hr hr1 hr2 hr3 hr4 hr5 hr6 hr7 hr8
  rw [Apply.push_ok h, Apply.push_ok hout7, Apply.push_ok hout6, Apply.push_ok hout5, Apply.push_ok hout4,
    Apply.push_ok hout3, Apply.push_ok hout2, Apply.push_ok hout1, Apply.push_ok hout_1]
  have hm : Pred.abs models = if allm then .all else namesA names.val := by
    cases allm
    · simp only [Bool.false_eq_true, ↓reduceIte] at hmodels ⊢; exact p_names_ok _ _ hmodels
    · simp only [↓reduceIte, ok.injEq] at hmodels ⊢; subst hmodels; rfl
  have hres : Pred.abs reservations = if m0 then .eq 1 (int 0) else noneA := by
    cases m0
    · simp only [Bool.false_eq_true, ↓reduceIte, ok.injEq] at hreservations ⊢; subst hreservations; plan_simp
    · simp only [↓reduceIte] at hreservations ⊢; plan_simp at hreservations; subst hreservations; plan_simp
  simp only [vec_new_val, List.map_append, List.map_cons, List.map_nil, List.nil_append, List.cons_append,
    List.singleton_append, Read.abs, Window.abs, h5i_app_sql.whole, planA]
  simp [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, hm, hres, Pred.abs, noneA,
    keysA, teamsA, teamModelsA, usageA, reservationsA, resKey, resTeam, keyTeam, teamRow,
    T_SETTINGS, T_TEAMS, T_KEYS, T_MODELS, T_DEPLOYMENTS, T_KEY_MODELS, T_TEAM_MODELS, T_USAGE, T_RESERVATIONS,
    COL_FIRST, KEY_TEAM, MODEL_NAME, USAGE_ID, RES_KEY, RES_TEAM, SCOPE_KEY, SCOPE_TEAM, SCOPE_DEPLOYMENT]

/-! ## What a batch reads -/

theorem add_id_ok (v v' : alloc.vec.Vec U64) (x : U64) (h : add_id v x = ok v') : v'.val = addId v.val x := by
  unfold add_id at h
  obtain ⟨b, hb⟩ := ok_of (contains_spec v x)
  have hp := post_of_ok (contains_spec v x) hb
  rw [hb] at h
  simp only [bind_tc_ok, bind_ok] at h
  have hmem : x.val ∈ v.val.map (fun y => y.val) ↔ x ∈ v.val := by
    constructor
    · intro hm; obtain ⟨y, hy, he⟩ := List.mem_map.1 hm; rwa [(Schema.u64_val_eq _ _).1 he] at hy
    · intro hm; exact List.mem_map.2 ⟨x, hm, rfl⟩
  cases b
  · simp only [Bool.false_eq_true, ↓reduceIte] at h
    have : x ∉ v.val := fun hx => by simpa using hp.2 (hmem.2 hx)
    rw [Apply.push_ok h, addId, if_neg this]
  · simp only [↓reduceIte, ok.injEq] at h
    subst h
    rw [addId, if_pos (hmem.1 (hp.1 rfl))]

theorem has_name_spec (v : alloc.vec.Vec (alloc.vec.Vec U8)) (n : alloc.vec.Vec U8) :
    has_name v n ⦃ b => (b = true ↔ v.val.any (fun m => decide (m.val = n.val)) = true) ⦄ := by
  unfold has_name has_name_loop
  apply WP.spec_mono (loop_search v.val (fun m => decide (m.val = n.val)) (fun b : Bool => b)
    (fun _ _ => true) false _ ?_ 0#usize (by simp))
  · intro r hr
    rw [hr, searchFrom_const]
    simp
  · intro j hj; unfold has_name_loop.body; h5i_step

theorem add_name_ok (v v' : alloc.vec.Vec (alloc.vec.Vec U8)) (n : alloc.vec.Vec U8) (h : add_name v n = ok v') :
    v'.val = addName v.val n := by
  unfold add_name at h
  obtain ⟨b, hb⟩ := ok_of (has_name_spec v n)
  have hp := post_of_ok (has_name_spec v n) hb
  rw [hb] at h
  simp only [bind_tc_ok, bind_ok] at h
  cases b
  · simp only [Bool.false_eq_true, ↓reduceIte, Schema.u8vec_clone, bind_tc_ok, bind_ok] at h
    have : ¬ v.val.any (fun m => decide (m.val = n.val)) = true := fun hx => by simpa using hp.2 hx
    rw [Apply.push_ok h, addName, if_neg this]
  · simp only [↓reduceIte, ok.injEq] at h
    subst h
    rw [addName, if_pos (hp.1 rfl)]

/-- The batch plan's loop gathers `wantsA` of its items. -/
theorem batch_plan_loop_ok (items : alloc.vec.Vec BatchItem) (keys res : alloc.vec.Vec U64)
    (names : alloc.vec.Vec (alloc.vec.Vec U8)) (m0 : Bool) (i : Usize)
    (r : alloc.vec.Vec U64 × alloc.vec.Vec U64 × alloc.vec.Vec (alloc.vec.Vec U8) × Bool)
    (hi : (⟨keys.val, res.val, names.val, m0⟩ : Wants) = wantsA (items.val.take i.val)) (hn : i.val ≤ items.val.length)
    (h : batch_plan_loop items keys res names m0 i = ok r) :
    (⟨r.1.val, r.2.1.val, r.2.2.1.val, r.2.2.2⟩ : Wants) = wantsA items.val := by
  unfold batch_plan_loop at h
  refine loop_idx_ok _ (fun x => x.2.2.2.2) items.val.length
    (fun x => (⟨x.1.val, x.2.1.val, x.2.2.1.val, x.2.2.2.1⟩ : Wants) = wantsA (items.val.take x.2.2.2.2.val))
    (fun y => (⟨y.1.val, y.2.1.val, y.2.2.1.val, y.2.2.2⟩ : Wants) = wantsA items.val) ?_ _ _ hi hn h
  rintro ⟨k, rs, ns, m, j⟩ res' hI hj hr
  simp only at hI hj hr
  unfold batch_plan_loop.body at hr
  by_cases hlt : j.val < items.val.length
  · rw [if_pos ((lt_len_iff _ _).2 hlt), vec_index_eq _ _ hlt] at hr
    simp only [bind_tc_ok, bind_ok] at hr
    obtain ⟨j2, hj2, hj2v⟩ := succ_ok j _ hlt items.property
    obtain ⟨⟨k1, b⟩, hk1, hr⟩ := bind_tc_eq_ok.1 hr
    obtain ⟨⟨rs1, ns1, m1⟩, hrest, hr⟩ := bind_tc_eq_ok.1 hr
    simp only [hj2, bind_ok] at hr
    change ok (ControlFlow.cont (k1, rs1, ns1, m1, j2)) = ok res' at hr
    simp only [ok.injEq] at hr
    subst hr
    refine ⟨?_, by simp [hj2v], by simp [hj2v]; omega⟩
    simp only [hj2v]
    rw [List.take_add_one, List.getElem?_eq_getElem hlt, Option.toList_some, wantsA, List.foldl_append,
      ← wantsA, ← hI]
    simp only [List.foldl_cons, List.foldl_nil]
    generalize items.val[j.val] = it at hk1 hrest
    obtain ⟨ik, im, op⟩ := it
    have hkeys : k1.val = (if im then k.val else addId k.val ik) ∧ b = im := by
      cases im
      · simp only [Bool.false_eq_true, ↓reduceIte] at hk1 ⊢
        obtain ⟨k2, hk2, e⟩ := bind_tc_eq_ok.1 hk1
        simp only [ok.injEq, Prod.mk.injEq] at e
        obtain ⟨rfl, rfl⟩ := e
        exact ⟨add_id_ok _ _ _ hk2, rfl⟩
      · simp only [↓reduceIte, ok.injEq, Prod.mk.injEq] at hk1 ⊢
        obtain ⟨rfl, rfl⟩ := hk1
        exact ⟨rfl, rfl⟩
    obtain ⟨hk, rfl⟩ := hkeys
    cases op with
    | Admit model pt mt ex =>
      simp only at hrest
      obtain ⟨n2, hn2, e⟩ := bind_tc_eq_ok.1 hrest
      cases b <;> simp only [Bool.false_eq_true, ↓reduceIte, bind_tc_ok, bind_ok, ok.injEq, Prod.mk.injEq] at e <;>
        obtain ⟨rfl, rfl, rfl⟩ := e <;> simp [wantStep, hk, add_name_ok _ _ _ hn2]
    | Settle rid pt ct st =>
      simp only at hrest
      obtain ⟨r2, hr2, e⟩ := bind_tc_eq_ok.1 hrest
      simp only [ok.injEq, Prod.mk.injEq] at e
      obtain ⟨rfl, rfl, rfl⟩ := e
      simp [wantStep, hk, add_id_ok _ _ _ hr2]
  · rw [if_neg (mt (lt_len_iff _ _).1 hlt)] at hr
    simp only [ok.injEq] at hr
    subst hr
    simp only
    rw [hI, List.take_of_length_le (by omega)]

theorem caller_keys_ok (a : Principal) (v : alloc.vec.Vec U64) (h : caller_keys a = ok v) : v.val = callerA a := by
  unfold caller_keys at h
  unfold callerA
  cases hm : a.master <;> simp only [hm, Bool.false_eq_true, ↓reduceIte, ok.injEq] at h ⊢
  · rw [Apply.push_ok h]; rfl
  · subst h; rfl

/-- The extracted `read_plan` computes `readsA`. -/
theorem reads_abs (a : Principal) (c : Command) (o : Option (alloc.vec.Vec h5i_app_sql.Read))
    (h : read_plan a c = ok o) : planOf o = readsA a c := by
  cases c <;> simp only [read_plan] at h
  case Admit nm pt mt ex =>
    simp only [Schema.u8vec_clone, bind_tc_ok, bind_ok] at h
    obtain ⟨names, hnames, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v1, hv1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, caller_keys_ok _ _ hv1,
      Apply.push_ok hnames, vec_new_val, List.nil_append]
  case Settle rid pt ct st =>
    obtain ⟨rs, hrs, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v1, hv1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, caller_keys_ok _ _ hv1,
      Apply.push_ok hrs, vec_new_val, List.nil_append]
  case Expire rid =>
    obtain ⟨rs, hrs, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v1, hv1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, caller_keys_ok _ _ hv1,
      Apply.push_ok hrs, vec_new_val, List.nil_append]
  case KeyInfo id =>
    obtain ⟨ks, hks, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨ks1, hks1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, Apply.push_ok hks1,
      caller_keys_ok _ _ hks, vec_new_val]
  case TeamInfo id =>
    obtain ⟨ts, hts, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v1, hv1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, caller_keys_ok _ _ hv1,
      Apply.push_ok hts, vec_new_val, List.nil_append]
  case ListModels =>
    obtain ⟨v1, hv1, h⟩ := bind_tc_eq_ok.1 h
    obtain ⟨v2, hv2, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hv2, caller_keys_ok _ _ hv1, vec_new_val]
  case Batch items =>
    obtain ⟨v, hv, h⟩ := bind_tc_eq_ok.1 h
    simp only [ok.injEq] at h; subst h
    unfold batch_plan at hv
    obtain ⟨⟨k, r, n, m⟩, hl, hp⟩ := bind_tc_eq_ok.1 hv
    have hw := batch_plan_loop_ok items _ _ _ false 0#usize _ (by simp [wantsA]) (by simp) hl
    have hk := congrArg Wants.keys hw; have hr := congrArg Wants.res hw
    have hn := congrArg Wants.names hw; have hm := congrArg Wants.m0 hw
    simp only at hk hr hn hm
    simp only [planOf, Option.map_some, readsA, plan_of_ok _ _ _ _ _ _ _ hp, vec_new_val, ← hk, ← hr, ← hn, ← hm]
  all_goals (simp only [ok.injEq] at h; subst h; rfl)

end gateway_kernel.Plan
